# ===== Smart Water platform - environment variables =====
# Copy to .env (docker compose reads it automatically).

# --- PostgreSQL
POSTGRES_DB=smartwater
POSTGRES_USER=smartwater
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Security (REQUIRED). JWT_SECRET must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Demo data (LOCAL ONLY). Set to false for any real deployment.
SEED_DEMO_DATA=true

# --- E-mail (optional). With MAIL_ENABLED=false e-mails are only written to the backend log.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@your-domain.com

# --- Alerts / automation (optional)
ALERT_HIGH_USAGE_KL=1.0
BILLING_AUTO_CYCLE_ENABLED=false
TIPS_EMAIL_ENABLED=false

# --- Published ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
